# Copy this file to .env in the same directory as docker-compose.yaml and
# fill in real values. .env stays out of the repo/compose YAML itself —
# same pattern you already use for Vaultwarden.
#
# All services below run on the NAS host network, so Homepage reaches
# them at 127.0.0.1:<port> directly — this bypasses Caddy and any
# basic-auth wall entirely, no auth headers needed.

# Jellyfin — Dashboard > Advanced > API Keys > + (add new key)
HOMEPAGE_VAR_JELLYFIN_URL=http://127.0.0.1:8096
HOMEPAGE_VAR_JELLYFIN_KEY=changeme

# Home Assistant — Profile (bottom left) > Security > Long-Lived Access Tokens
HOMEPAGE_VAR_HASS_URL=http://127.0.0.1:8123
HOMEPAGE_VAR_HASS_KEY=changeme

# Uptime Kuma — the widget reads a public Status Page, not the API.
# Create one (Settings > Status Pages), group your monitors on it, then
# take the slug from the page's own URL: .../status/<slug>
HOMEPAGE_VAR_KUMA_URL=http://127.0.0.1:3001
HOMEPAGE_VAR_KUMA_SLUG=changeme

# Weather (native Homepage Open-Meteo widget — no API key required).
# Approximate coordinates are fine; round to city-level if you'd rather
# not put your exact location in a config file. See widgets.yaml.
HOMEPAGE_VAR_WEATHER_LATITUDE=changeme
HOMEPAGE_VAR_WEATHER_LONGITUDE=changeme
