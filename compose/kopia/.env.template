# Copy to .env (gitignored) and fill in the real values.
# Two different passwords, don't conflate them:
#   KOPIA_PASSWORD        - encrypts the actual backup repository. Losing
#                            this means losing access to every snapshot.
#   KOPIA_SERVER_PASSWORD - just the web UI/API login for Kopia's own
#                            server mode.
KOPIA_PASSWORD=changeme
KOPIA_SERVER_PASSWORD=changeme

# Cloudflare R2 (S3-compatible object storage) — where the repository
# itself actually lives. None of these are read by the container at
# runtime (nothing in docker-compose.yaml's `environment:` references
# them) — they're only needed once, for the `kopia repository create s3`
# bootstrap command run directly on the NAS (see README.md). Kept here
# anyway so the real values have one documented home instead of living
# only in your head or a password manager entry with no context.
#   R2_ACCOUNT_ID         - Cloudflare dashboard -> R2 -> shown on the
#                            R2 overview page. Used to build the S3
#                            endpoint: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
#   R2_BUCKET_NAME         - the bucket you create for this (e.g. nas-backups)
#   R2_ACCESS_KEY_ID       - from an R2 API token scoped to Object Read & Write
#   R2_SECRET_ACCESS_KEY   - shown once when the token is created — save it now
R2_ACCOUNT_ID=changeme
R2_BUCKET_NAME=changeme
R2_ACCESS_KEY_ID=changeme
R2_SECRET_ACCESS_KEY=changeme
