# Copy this file to .env in this same directory (compose/wud/) once you're
# ready to deploy WUD — see DEPLOYMENT.md "Part 3" for the full sequence.
# Per-project .env, same pattern as Vaultwarden and Homepage.

# WUD's built-in local login (protects its own web UI at :3002) — also
# reused by stacks-collector to call WUD's REST API.
WUD_AUTH_ADMIN_USER=changeme
WUD_AUTH_ADMIN_PASSWORD=changeme

# Read by stacks-collector (same credentials as above; kept as separate
# vars so the collector's env doesn't depend on WUD's own config schema).
WUD_USER=changeme
WUD_PASS=changeme
