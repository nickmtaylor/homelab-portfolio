# Copy the SAME real values already used in Homepage's own .env
# (HOMEPAGE_VAR_WEATHER_LATITUDE / HOMEPAGE_VAR_WEATHER_LONGITUDE) — it's
# the same physical location, no need for a second secret. Fetched
# server-side by system_metrics_collector.py's /weather endpoint, never
# sent to the browser directly.
WEATHER_LATITUDE=changeme
WEATHER_LONGITUDE=changeme
WEATHER_UNITS=imperial
WEATHER_LABEL=Home
