# Copy to .env (gitignored) and fill in the real token.
#
# The version of this compose file that's actually running on the NAS right
# now has this token hardcoded inline, twice, with no .env at all — that's
# what this template fixes going forward. Deploying this templated version
# means adding a real .env next to docker-compose.yaml on the NAS itself
# too, not just locally (Docker Compose reads .env for ${VAR} substitution
# automatically, no env_file: directive needed for this).
#
# Real value: the same Cloudflare API token already in use — check the
# live compose file on the NAS (or your password manager) rather than
# generating a new one, unless you're rotating it anyway.
CLOUDFLARE_API_TOKEN=changeme
